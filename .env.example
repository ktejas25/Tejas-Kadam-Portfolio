# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Exposed to the browser via Vite / Cloudflare Pages)
# ------------------------------------------------------------------------------

# Public Builder.io key (optional)
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Web3Forms API Access Key for Contact Form Submissions
# Obtain a free key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=a2afd3c9-849a-41ba-8b70-9068de605274

# ------------------------------------------------------------------------------
# 2. SERVER & EDGE SECRETS (Never exposed to the browser)
# ------------------------------------------------------------------------------

# Message returned by /api/ping endpoint
PING_MESSAGE="ping from Cloudflare Edge"

# Server port for local Node.js standalone server (default: 3000)
PORT=3000
